# ============================================
# GreenReward — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=greenreward

# JWT Secret (change this to any random string)
JWT_SECRET=greenreward_super_secret_2025_change_this

# OpenWeatherMap API Key (FREE — get from openweathermap.org)
WEATHER_API_KEY=your_openweathermap_api_key_here

# Anthropic API Key (for AI chatbot — get from console.anthropic.com)
# Leave blank to use the built-in rule-based chatbot
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server
PORT=3000
